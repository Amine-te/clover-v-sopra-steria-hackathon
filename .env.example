# Karis backend configuration. Copy this file to ".env" at the project root and fill in your values.
# NEVER commit the real .env file (it is git-ignored). Variables are documented in specs/contracts/config.md.

# AWS access key ID (least-privilege game-day key); leave empty to use AWS_PROFILE instead
AWS_ACCESS_KEY_ID=
# AWS secret access key matching AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=
# Optional named AWS CLI profile (documentation only; export it in the shell to make live tests use it)
AWS_PROFILE=hackathon
# AWS region for every service call (Bedrock models are enabled in us-east-1)
AWS_DEFAULT_REGION=us-east-1
# Existing S3 bucket for audio files and observation JSON
GAMEDAY_BUCKET=your-bucket-name
# Bedrock inference profile for extraction, follow-ups and message wording (Claude Haiku 4.5)
BEDROCK_MODEL_EXTRACT=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Bedrock inference profile for the doctor report chronology (Claude Sonnet 4)
BEDROCK_MODEL_REPORT=us.anthropic.claude-sonnet-4-20250514-v1:0
# Bedrock Guardrail identifier (set up in feature 006); leave empty until then
GUARDRAIL_ID=
# Bedrock Guardrail version (for example 1 or DRAFT); leave empty until then
GUARDRAIL_VERSION=
# AWS Transcribe language code for caregiver voice reports
TRANSCRIBE_LANGUAGE=fr-FR
# Notification channel: mock, sns, ses or telegram
NOTIFY_CHANNEL=mock
# Use cached fixture transcripts instead of calling Transcribe: true, false, 1 or 0
USE_CACHED_TRANSCRIPTS=false
# Daily check-in reminder time, local, HH:MM (24-hour)
CHECKIN_TIME=20:00
# Host interface the backend API listens on
API_HOST=127.0.0.1
# Port the backend API listens on (1-65535)
API_PORT=8000
# Comma-separated list of exact frontend origins allowed by CORS (no wildcard)
CORS_ORIGINS=http://localhost:3000
# Bedrock model used only by samples/bedrock_sample.py (ignored by the backend)
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
