# Application
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Database (PostgreSQL 16 via docker compose — host port 5433)
DATABASE_URL=postgresql+psycopg://karis:karis@localhost:5433/karis

# Frontend origin (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Providers — all default to deterministic mocks (zero AWS credentials needed)
LLM_PROVIDER=mock
# Reset tools are available only in development/demo/test, never production.
DEMO_RESET_ENABLED=true
# Bedrock failures use the deterministic demo path; set false for explicit 502 errors.
LLM_FALLBACK_TO_MOCK=true
STT_PROVIDER=mock
SER_PROVIDER=mock
WEARABLE_PROVIDER=mock
OBJECT_STORAGE_PROVIDER=mock
MESSAGING_PROVIDER=mock

# AWS (required at invocation only when using optional live providers)
AWS_DEFAULT_REGION=
GAMEDAY_BUCKET=
AWS_BEDROCK_MODEL_ID=
