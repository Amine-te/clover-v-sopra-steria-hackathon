# Copy this file to ".env" and fill in your values.
# NEVER commit the real .env file (it is git-ignored).

# Least-privilege AK/SK created per docs/IAM_SETUP.md
AWS_ACCESS_KEY_ID=AK....
AWS_SECRET_ACCESS_KEY=......

# Region where you enabled Bedrock models (us-east-1 recommended)
AWS_DEFAULT_REGION=us-east-1

# S3 bucket used by the S3 sample (any bucket you have access to)
GAMEDAY_BUCKET=your-bucket-name

# Optional: Bedrock model id to use in the Bedrock sample.
# See `python bedrock_sample.py --list` for what's available/enabled.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
